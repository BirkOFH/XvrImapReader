{
  "name": "n8n-nodes-xvr-advanced-imap",
  "version": "1.0.0",
  "description": "Advanced IMAP node for n8n with full attachment support, powered by ImapFlow",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "imap",
    "email",
    "xvr",
    "advanced-imap",
    "imapflow",
    "attachments"
  ],
  "license": "ISC",
  "homepage": "https://github.com/BirkOFH/XvrImapReader",
  "author": {
    "name": "BirkOFH",
    "email": "your-email@example.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BirkOFH/XvrImapReader.git"
  },
  "main": "dist/index.js",
  "scripts": {
    "test": "tsc && node dist/app.js",
    "test:advanced": "tsc && node dist/TestRunnerAdvanced.js",
    "test:attachments": "tsc && node dist/TestAttachments.js",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "dev": "tsc && node dist/app.js",
    "start": "node dist/app.js"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/MyImap.credentials.js"
    ],
    "nodes": [
      "dist/MyImap.node.js"
    ]
  },
  "dependencies": {
    "imapflow": "^1.0.177",
    "mailparser": "^3.9.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.4",
    "@types/node": "^25.0.3",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "n8n-workflow": "^2.3.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.10.0"
  }
}
