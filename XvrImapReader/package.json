{
  "name": "xvrimapreader",
  "version": "1.0.0",
  "description": "Advanced IMAP Node for n8n",
  "main": "dist/app.js",
  "scripts": {
    "test": "tsc && node dist/app.js",
    "test:advanced": "tsc && node dist/TestRunnerAdvanced.js",
    "test:attachments": "tsc && node dist/TestAttachments.js",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "dev": "tsc && node dist/app.js",
    "start": "node dist/app.js"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "imap",
    "email"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/MyImap.credentials.js"
    ],
    "nodes": [
      "dist/MyImap.node.js"
    ]
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "imapflow": "^1.0.177",
    "mailparser": "^3.9.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.4",
    "@types/node": "^25.0.3",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "n8n-workflow": "^2.3.0",
    "typescript": "^5.9.3"
  }
}
